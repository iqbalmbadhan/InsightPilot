# ─────────────────────────────────────────────────────────────────────────────
# InsightPilot — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in values.
# Without any key the app runs in DEMO MODE (returns a sample result).

# ── Option A: OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini     # default — fast and cheap
# OPENAI_MODEL=gpt-4o          # upgrade for deeper reasoning

# ── Option B: OpenRouter ──────────────────────────────────────────────────────
# IMPORTANT: use the API model ID, NOT the display name from the UI.
# Model IDs follow the format:  provider/model-name
# Find the ID at https://openrouter.ai/models (copy the "API name" field)
#
# OPENROUTER_API_KEY=sk-or-...
#
# Free-tier models (no credits needed):
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_MODEL=google/gemma-3-4b-it:free
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
# OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free
#
# Paid models (better quality):
# OPENROUTER_MODEL=openai/gpt-4o-mini       # default if OPENROUTER_API_KEY is set
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_MODEL=anthropic/claude-haiku-4-5
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Force demo mode even when an API key is set (useful for UI testing)
# DEMO_MODE=true
