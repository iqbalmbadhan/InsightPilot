# ─────────────────────────────────────────────────────────────────────────────
# InsightPilot — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Without an API key the app runs in DEMO MODE (mock AI output).

# ── Option A: OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini          # default: gpt-4o-mini  (fast + cheap)
# OPENAI_MODEL=gpt-4o               # upgrade for deeper analysis

# ── Option B: OpenRouter (100+ models via one key) ────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set DEMO_MODE=true to skip AI calls and return a canned response.
# Useful for UI testing without burning tokens.
# DEMO_MODE=true
