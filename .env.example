# ─────────────────────────────────────────────────────────────────────────────
# InsightPilot — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in values.
# Without any key the app runs in DEMO MODE (returns a realistic sample result).

# ── Option A: OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini     # default — fast, cheap, great JSON output
# OPENAI_MODEL=gpt-4o          # best quality

# ── Option B: OpenRouter (many free models) ───────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
#
# ⚠️  Use the API model ID — NOT the display name shown in the OpenRouter UI.
#     Format:  provider/model-name[:free]
#     Find it: openrouter.ai/models → click a model → copy "API name"
#
# ── RECOMMENDED FREE MODELS ───────────────────────────────────────────────────
#
# Best quality + reliable JSON:
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Fastest + most reliable JSON:
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
#
# Lightweight fallback:
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
#
# Good structured output:
# OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free
#
# ── AVOID ─────────────────────────────────────────────────────────────────────
# ✗ Reasoning/thinking models (deepseek-r1, o1, QwQ, nemotron-reasoning…)
#   → output long <think> chains, often fail structured JSON tasks
# ✗ Models ending in :free that return 404 have been retired by OpenRouter
#   → check openrouter.ai/models for currently active free models
#
# ── Paid models (no rate limits, best quality) ────────────────────────────────
# OPENROUTER_MODEL=openai/gpt-4o-mini          # default if no suffix set
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_MODEL=anthropic/claude-haiku-4-5
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Force demo mode even when a key is present (useful for UI testing)
# DEMO_MODE=true
